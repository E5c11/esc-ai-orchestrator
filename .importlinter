[importlinter]
root_packages =
    esc_orchestrator
    esc_exec
include_external_packages = True

[importlinter:contract:layers]
name = Clean layers (entrypoints > application > domain)
type = layers
layers =
    esc_orchestrator.entrypoints
    esc_orchestrator.application
    esc_orchestrator.domain

[importlinter:contract:pure-domain]
name = Domain performs no I/O and uses no framework
type = forbidden
source_modules = esc_orchestrator.domain
forbidden_modules =
    sqlite3
    subprocess
    socket
    http
    urllib
    requests
    httpx
    pydantic

[importlinter:contract:only-the-composition-root-builds-infrastructure]
name = Only the composition root touches infrastructure (PYCOMP-ROOT-01, PYCOMP-ROOT-02)
type = forbidden
source_modules =
    esc_orchestrator.domain
    esc_orchestrator.application
    esc_orchestrator.entrypoints
forbidden_modules =
    esc_orchestrator.store
    esc_orchestrator.runtime
    esc_orchestrator.scheduler
    esc_orchestrator.composition

[importlinter:contract:pure-renderers]
name = Renderers are pure (PYEP-RENDER-01): no file, registry, git or process access
type = forbidden
source_modules = esc_orchestrator.entrypoints.cli.render
forbidden_modules =
    esc_exec.yaml_io
    esc_exec.worktree
    esc_exec.registry
    esc_exec.manifests
    esc_exec.checkpoints
    esc_exec.claude_client
    esc_exec.claude_code_adapter
    subprocess
    sqlite3
    shutil
